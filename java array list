import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int n = scanner.nextInt();
        List<List<Integer>> lines = new ArrayList<>();

        // Read n lines of integers
        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt();
            List<Integer> line = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                line.add(scanner.nextInt());
            }
            lines.add(line);
        }

        int q = scanner.nextInt();

        // Process q queries
        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // line number (1-based)
            int y = scanner.nextInt(); // position number (1-based)

            // Convert to 0-based indexing
            int lineIdx = x - 1;
            int posIdx = y - 1;

            // Check bounds
            if (lineIdx >= 0 && lineIdx < lines.size()) {
                List<Integer> currentLine = lines.get(lineIdx);
                if (posIdx >= 0 && posIdx < currentLine.size()) {
                    System.out.println(currentLine.get(posIdx));
                } else {
                    System.out.println("ERROR!");
                }
            } else {
                System.out.println("ERROR!");
            }
        }

        scanner.close();
    }
}
